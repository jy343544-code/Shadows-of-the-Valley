config_version=5

[application]
config/name="Shadows of the Valley"
run/main_scene="res://scenes/black_gate.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="A mobile third-person action prototype set in a fictional ancient Egyptian-inspired world."

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.055, 0.045, 0.035, 1)
